[run]
source = 
    app
    backtest
    fetch
    indicators
    sentiment
    validation
omit = 
    test_*
    run_backtest.py
    plot_indicators.py
    .venv/*

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError

